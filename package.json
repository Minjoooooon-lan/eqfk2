{
  "name": "future-you-2036",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Future You 2036 Simulator - an interactive branching future-life and career game with an AI career mentor",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
